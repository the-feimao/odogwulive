APP_NAME="Event App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Public canonical URL used for SEO tags and the sitemap
BRAND_CANONICAL_URL=http://localhost
SEO_TWITTER_HANDLE=@Odogwufest
BRAND_CURRENCY=NGN

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=event_app
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# AWS / filesystem (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
FILESYSTEM_DRIVER=local

# Pusher (optional)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Paystack (if used)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=

# Flutterwave / Rave (if used)
RAVE_PUBLIC_KEY=
RAVE_SECRET_KEY=
RAVE_TITLE="${APP_NAME}"
RAVE_ENVIRONMENT=staging
RAVE_LOGO=
RAVE_PREFIX=rave
RAVE_SECRET_HASH=

# OneSignal - App/User notifications (if used)
APP_ID=
REST_API_KEY=
USER_AUTH_KEY=

# OneSignal - Organizer notifications (if used)
ORG_APP_ID=
ORG_REST_API_KEY=
ORG_USER_AUTH_KEY=
